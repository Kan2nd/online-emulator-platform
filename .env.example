# Copy this file to .env and fill in ABSOLUTE HOST paths (not container
# paths). docker compose does not reliably expand ${PWD} on Windows, so
# these must be set explicitly.
#
# Example (Windows, forward slashes work fine for Docker Desktop):
ROMS_HOST_DIR=D:/STUDY/Sem alone/Project ContainerEmulator/roms
SAVES_HOST_DIR=D:/STUDY/Sem alone/Project ContainerEmulator/saves

# Optional. On Docker Desktop (Windows/Mac), promtail's default log
# scraping (via a bind-mounted /var/lib/docker/containers) doesn't work —
# that path lives inside the Desktop VM, not your filesystem. Set this to
# have emulator containers log straight to Loki instead (needs
# `docker plugin install grafana/loki-docker-driver:latest --alias loki`
# installed once on the host). Leave unset on a native Linux Docker host.
LOKI_URL=http://localhost:3100/loki/api/v1/push

# Admin key for approving/rejecting uploads and deleting games. Generate a
# long random value, e.g. `openssl rand -hex 24`, and keep it out of git.
ADMIN_TOKEN=
