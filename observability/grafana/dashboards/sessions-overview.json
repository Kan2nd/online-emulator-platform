{
  "title": "Container emulator - sessions overview",
  "uid": "container-emulator-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Active sessions",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        { "expr": "container_emulator_active_sessions", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Session start latency (p95)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(container_emulator_session_start_duration_seconds_bucket[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Save flush errors (5m)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        { "expr": "increase(container_emulator_save_flush_errors_total[5m])", "refId": "A" }
      ]
    }
  ]
}
